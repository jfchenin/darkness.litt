---
// src/components/CollectionPost.astro
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { render } from 'astro:content'
import Comment from '@/components/Comment/Index.astro'
import PostAuthor from '@/components/PostAuthor.astro'
import PostDate from '@/components/PostDate.astro'
import TagList from '@/components/TagList.astro'
import BackButton from '@/components/Widgets/BackButton.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { getLangFromLocale } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'
import { getPostDescription } from '@/utils/description'
import type { PostCollection } from '@/utils/posts'

interface Props {
  post: CollectionEntry<PostCollection>
  supportedLangs: Language[]
  showAuthor: boolean
}

const { post, supportedLangs, showAuthor } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={slug}
  supportedLangs={supportedLangs}
>
  <article class="heti">
    <div class="relative">
      <!-- Go Back Button On Desktop -->
      <BackButton />
      <!-- Title -->
      <h1 class="post-title font-title">
        <span
          transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-transition
        >
          {post.data.title}
        </span>
      </h1>
    </div>

    <!-- Date -->
    <div
      id="post-date"
      class="mb-17.2 block c-primary font-time"
      transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
      data-disable-theme-transition
    >
      {showAuthor && (
        <PostAuthor
          postAuthor={post.data.author}
        />
      )}
      <PostDate
        date={post.data.published}
        updatedDate={post.data.updated}
        minutes={remarkPluginFrontmatter.minutes}
      />
    </div>
    <!-- TOC -->
    {post.data.toc && <TOC headings={headings} />}
    <!-- Content -->
    <div id="post-content">
      <Content />
      <!-- Copyright -->
      <div id="post-copyright" />
      <!-- Tag List -->
      {post.data.tags?.length > 0 && (
        <div class="mt-12.6 uno-decorative-line" />
        <TagList
          tags={post.data.tags}
          lang={currentLang}
        />
      )}
      <!-- Comment -->
      <Comment />
    </div>
  </article>
</Layout>
