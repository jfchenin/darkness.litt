---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import CollectionPost from '@/components/CollectionPost.astro'
import { buildCollectionSlugPaths } from '@/utils/collectionSlugPaths'

export async function getStaticPaths() {
  return buildCollectionSlugPaths('darkness')
}

interface Props {
  post: CollectionEntry<'darkness'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
---

<CollectionPost post={post} supportedLangs={supportedLangs} showAuthor={true} />
