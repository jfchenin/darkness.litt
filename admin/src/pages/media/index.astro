---
// admin/src/pages/media/index.astro
export const prerender = false
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Médias — darkness.litt</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        padding: 1.5rem;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        background: Canvas;
        color: CanvasText;
      }
      main {
        max-width: 36rem;
        margin: 0 auto;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 1rem;
      }
      form {
        display: grid;
        gap: 0.75rem;
        margin: 0 0 1.5rem;
      }
      label {
        display: grid;
        gap: 0.25rem;
      }
      textarea {
        font-family: ui-monospace, monospace;
        min-height: 8rem;
      }
      [hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Téléverser une image JPEG</h1>
      <p>
        Retour à l’<a href="/">administration</a>. Les images ne sont jamais
        écrasées ni supprimées ici.
      </p>

      <form id="upload-form">
        <label>
          Collection
          <select name="collection" required>
            <option value="darkness">darkness</option>
            <option value="emileMoselly">emileMoselly</option>
          </select>
        </label>
        <label>
          Nom du fichier (minuscules, chiffres et tirets)
          <input name="filename" required pattern="[a-z0-9\-]+(\.jpg)?" placeholder="couverture-1" />
        </label>
        <label>
          Fichier JPEG
          <input name="file" type="file" accept="image/jpeg" required />
        </label>
        <button type="submit">Téléverser</button>
        <p id="upload-status" role="status"></p>
      </form>

      <form id="tag-form" hidden>
        <p>Image enregistrée sous <code id="tag-key"></code>. Collez ce bloc dans l’article :</p>
        <label>
          Texte alternatif
          <input name="alt" />
        </label>
        <label>
          Orientation
          <select name="orientation">
            <option value="none">none</option>
            <option value="landscape">landscape</option>
            <option value="portrait">portrait</option>
          </select>
        </label>
        <label>
          <span><input name="hideCaption" type="checkbox" /> Masquer la légende</span>
        </label>
        <textarea id="tag-output" readonly></textarea>
        <button type="button" id="tag-copy">Copier</button>
      </form>
    </main>

    <script>
      const uploadForm = document.querySelector<HTMLFormElement>('#upload-form')!
      const uploadStatus = document.querySelector<HTMLElement>('#upload-status')!
      const tagForm = document.querySelector<HTMLFormElement>('#tag-form')!
      const tagKey = document.querySelector<HTMLElement>('#tag-key')!
      const tagOutput = document.querySelector<HTMLTextAreaElement>('#tag-output')!
      const tagCopy = document.querySelector<HTMLButtonElement>('#tag-copy')!

      let uploadedKey = ''

      // Builds the Markdoc image tag for the uploaded key from the tag form fields.
      function renderTag(): void {
        const data = new FormData(tagForm)
        const alt = String(data.get('alt') ?? '').replaceAll('"', '\\"')
        tagOutput.value = [
          '{% image',
          `   src="${uploadedKey}"`,
          `   alt="${alt}"`,
          `   orientation="${data.get('orientation')}"`,
          `   hideCaption=${data.get('hideCaption') === 'on'}`,
          '/%}',
        ].join('\n')
      }

      // Uploads the JPEG to /api/media and reveals the tag form on success.
      async function handleUpload(event: SubmitEvent): Promise<void> {
        event.preventDefault()
        const data = new FormData(uploadForm)
        const file = data.get('file') as File
        const filename = String(data.get('filename')).replace(/\.jpg$/, '')
        const key = `${data.get('collection')}/${filename}.jpg`

        uploadStatus.textContent = 'Envoi en cours…'
        const response = await fetch(`/api/media?key=${encodeURIComponent(key)}`, {
          method: 'POST',
          body: file,
        })
        const result = await response.json().catch(() => ({})) as { error?: string }
        if (!response.ok) {
          uploadStatus.textContent = `Échec (${response.status}) : ${result.error ?? 'erreur inconnue'}`
          return
        }

        uploadStatus.textContent = 'Image enregistrée.'
        uploadedKey = key
        tagKey.textContent = key
        tagForm.hidden = false
        renderTag()
      }

      // Copies the generated tag to the clipboard.
      async function handleCopy(): Promise<void> {
        await navigator.clipboard.writeText(tagOutput.value)
        tagCopy.textContent = 'Copié'
      }

      uploadForm.addEventListener('submit', handleUpload)
      tagForm.addEventListener('input', renderTag)
      tagCopy.addEventListener('click', handleCopy)
    </script>
  </body>
</html>
