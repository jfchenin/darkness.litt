# admin/.env.example
# Wrangler secrets in production (never commit real values).
# "github" = GitHub storage (production); unset or anything else = local storage in admin/fixtures
KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
