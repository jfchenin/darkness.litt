# admin/.env.example
# Never commit real values.

# --- Build-time env vars (inlined into the bundle; set in admin/.env or the shell before `pnpm build`) ---
# "github" = GitHub storage (production; `pnpm run deploy` sets it for you); unset or anything else = local storage in admin/fixtures
KEYSTATIC_STORAGE=
# Slug of the GitHub App (from https://github.com/apps/<slug>); public, read by the browser bundle
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Wrangler secrets (runtime only; `wrangler secret put <NAME>`, not read from this file in production) ---
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
