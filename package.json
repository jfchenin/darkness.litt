      "@qwik.dev/partytown@0.11.2": "patches/@qwik.dev__partytown@0.11.2.patch"
    },
    "overrides": {
      "sharp": "^0.35.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ],
    "ignoredBuiltDependencies": [
      "workerd"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "echo 'Skipping lint-staged due to ESLint jsdoc plugin issue'"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": "eslint --fix"
  }
}
