{
  "name": "astro-theme-retypeset",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "repository": "https://github.com/radishzzz/astro-theme-retypeset",
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "git submodule update --init --recursive && astro check && astro build && pnpm apply-lqip",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "new-post": "tsx scripts/new-post.ts",
    "apply-lqip": "tsx scripts/apply-lqip.ts",
    "format-posts": "tsx scripts/format-posts.ts",
    "check-env": "node scripts/check-env.cjs",
    "test-botpoison": "node scripts/test-botpoison.cjs",
    "test": "tsx --test src/utils/secretsMatch.test.ts src/pages/api/formspark-webhook.test.ts src/pages/api/contact.test.ts shared/literary-fields.test.ts shared/article-image.test.ts src/utils/feedSanitize.test.ts src/utils/markdoc.test.ts src/utils/description.test.ts scripts/apply-lqip.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/markdoc": "^0.15.11",
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/partytown": "2.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@botpoison/browser": "^1.1.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@waline/client": "^3.16.1",
    "astro": "^5.18.2",
    "astro-compress": "^2.4.3",
    "astro-og-canvas": "^0.13.2",
    "feed": "^5.2.0",
    "katex": "^0.16.28",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it": "^14.1.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.12.2",
    "node-html-parser": "^7.0.2",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "twikoo": "^1.6.44",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@astrojs/check": "^0.9.11",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.9",
    "@types/sanitize-html": "^2.16.2",
    "@unocss/astro": "66.11.0",
    "@unocss/eslint-plugin": "66.11.0",
    "@unocss/preset-attributify": "66.11.0",
    "@unocss/reset": "66.11.0",
    "astro-eslint-parser": "^1.4.0",
    "autocorrect-node": "^2.14.0",
    "canvaskit-wasm": "^0.42.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.2.7",
    "playwright": "^1.64.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unocss": "66.11.0",
    "unocss-preset-theme": "^0.14.1",
    "wrangler": "^4.151.3"
